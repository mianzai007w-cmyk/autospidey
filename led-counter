<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LED Follower Counter</title>
  <style>
    body {
      background-color: #0b0c10;
      color: #66fcf1;
      font-family: 'Courier New', monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }

    .case-container {
      background: #111;
      border: 4px solid #333;
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 0 30px rgba(102, 252, 241, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Top Line of Lights / Bar Graph */
    .bar-graph {
      display: flex;
      gap: 6px;
      margin-bottom: 20px;
    }
    .bar {
      width: 8px;
      height: 25px;
      background-color: #1f2833;
      border-radius: 3px;
      transition: background-color 0.3s, box-shadow 0.3s;
    }
    .bar.active {
      background-color: #66fcf1;
      box-shadow: 0 0 10px #66fcf1;
    }

    /* 2-Digit Main Display */
    .display {
      font-size: 110px;
      font-weight: bold;
      letter-spacing: 6px;
      color: #66fcf1;
      text-shadow: 0 0 25px #66fcf1;
      border: 3px solid #1f2833;
      padding: 15px 35px;
      border-radius: 15px;
      background: #000;
    }

    /* Input Controls */
    .controls {
      margin-top: 30px;
      display: flex;
      gap: 12px;
    }
    input {
      padding: 12px;
      font-size: 20px;
      width: 90px;
      text-align: center;
      border-radius: 8px;
      border: none;
      background: #1f2833;
      color: #fff;
      outline: none;
    }
    button {
      padding: 12px 24px;
      font-size: 18px;
      background-color: #45a29e;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.2s;
    }
    button:hover {
      background-color: #66fcf1;
      color: #000;
    }
  </style>
</head>
<body>

  <div class="case-container">
    <!-- Top Bar Graph -->
    <div class="bar-graph" id="barGraph">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>

    <!-- 2-Digit Display -->
    <div class="display" id="ledNumber">00</div>
  </div>

  <!-- Manual Input Controls -->
  <div class="controls">
    <input type="number" id="followerInput" placeholder="12" min="0" max="99">
    <button onclick="updateDisplay()">Update</button>
  </div>

  <script>
    function updateDisplay() {
      let inputField = document.getElementById("followerInput");
      let val = inputField.value;
      if (val === "") return;

      // Ensure 2 digits (e.g. 5 -> 05)
      let formattedVal = val.padStart(2, '0').slice(-2);
      document.getElementById("ledNumber").innerText = formattedVal;

      // Light up top bars based on value (0 to 99)
      let num = parseInt(val);
      let bars = document.querySelectorAll(".bar");
      let activeBarsCount = Math.round((num / 100) * bars.length);

      bars.forEach((bar, index) => {
        if (index < activeBarsCount) {
          bar.classList.add("active");
        } else {
          bar.classList.remove("active");
        }
      });

      inputField.value = ""; // Clear input after updating
    }
  </script>
</body>
</html>
